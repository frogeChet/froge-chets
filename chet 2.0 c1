local DropObjects = {}
local function dropAnchor(inst)
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Tool") or inst:IsA("Model") then
        return (inst:IsA("Model") and inst.PrimaryPart)
            or inst:FindFirstChild("Handle")
            or inst:FindFirstChildWhichIsA("BasePart")
    end
end
local function insideChar(inst)
    local n = inst
    while n and n ~= Workspace do
        if n:FindFirstChildOfClass("Humanoid") then return true end
        n = n.Parent
    end
    return false
end
local function isLocalOrVM(inst)
    if Camera and inst:IsDescendantOf(Camera) then return true end
    local ch = LocalPlayer.Character
    if ch and inst:IsDescendantOf(ch) then return true end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp and inst:IsDescendantOf(bp) then return true end
    for _, plr in ipairs(Players:GetPlayers()) do
        local o = plr.Character
        if o and inst:IsDescendantOf(o) then return true end
    end
    return false
end
local function createDropESP(inst, part, role)
    local hl = Instance.new("Highlight")
    hl.FillTransparency = 0.6; hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Enabled = false; hl.Parent = Screen
    local bb = Instance.new("BillboardGui")
    bb.AlwaysOnTop = true; bb.LightInfluence = 0
    bb.Size = UDim2.fromOffset(220, 34)
    bb.StudsOffsetWorldSpace = Vector3.new(0, 1.2, 0)
    bb.Enabled = false; bb.Parent = Screen
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1,0,0,16)
    label.Font = Enum.Font.GothamBold; label.TextSize = 13
    label.TextStrokeTransparency = 0.35; label.Parent = bb
    local sub = label:Clone()
    sub.Font = Enum.Font.Gotham; sub.TextSize = 11
    sub.Position = UDim2.new(0,0,0,16); sub.Parent = bb
    DropObjects[inst] = {hl=hl, bb=bb, label=label, sub=sub, part=part, role=role}
    return DropObjects[inst]
end
local function removeDrop(inst)
    local d = DropObjects[inst]; if not d then return end
    pcall(function() d.hl:Destroy() end)
    pcall(function() d.bb:Destroy() end)
    DropObjects[inst] = nil
end
local function scanDrops()
    if not CFG.DropESP then
        for i in pairs(DropObjects) do removeDrop(i) end
        return
    end
    local found = {}
    local function check(inst)
        if inst:IsA("Tool") or inst:IsA("Model") then
            local role = weaponToRole(inst.Name)
            if role and not insideChar(inst) and not isLocalOrVM(inst) then
                local part = dropAnchor(inst)
                if part then found[inst] = {part=part, role=role} end
            end
        end
    end
    for _, c in ipairs(Workspace:GetChildren()) do check(c) end
    for i in pairs(DropObjects) do
        if not found[i] or not i.Parent then removeDrop(i) end
    end
    for i, d in pairs(found) do
        local dr = DropObjects[i] or createDropESP(i, d.part, d.role)
        dr.part = d.part; dr.role = d.role
    end
end
local function renderDrops()
    for i, d in pairs(DropObjects) do
        if not i.Parent or not d.part or not d.part.Parent then
            removeDrop(i)
        else
            local dist = (Camera.CFrame.Position - d.part.Position).Magnitude
            if not CFG.DropESP or dist > CFG.DropMaxDist or dist < (CFG.DropMinDist or 8) then
                if d.bb.Enabled then d.bb.Enabled = false end
                if d.hl.Enabled then d.hl.Enabled = false end
            else
                if not d.bb.Enabled then
                    local col = (d.role == "KILLER") and COLOR.killer or COLOR.vigilante
                    local k = S()
                    d.bb.Adornee = d.part
                    d.bb.Size = UDim2.fromOffset(220*k, 34*k)
                    d.label.Size = UDim2.new(1,0,0,16*k); d.label.TextSize = 13*k
                    d.label.Text = i.Name .. "  [" .. d.role .. "]"
                    d.label.TextColor3 = col
                    d.sub.Position = UDim2.new(0,0,0,16*k)
                    d.sub.Size = UDim2.new(1,0,0,14*k); d.sub.TextSize = 11*k
                    d.sub.TextColor3 = col
                    d.hl.Adornee = i:IsA("Model") and i or d.part
                    d.hl.OutlineColor = col; d.hl.FillColor = col
                    d.bb.Enabled = true
                end
                local dt = math.floor(dist) .. "m"
                if d.sub.Text ~= dt then d.sub.Text = dt end
                if d.hl.Enabled ~= CFG.DropHighlight then d.hl.Enabled = CFG.DropHighlight end
            end
        end
    end
end

