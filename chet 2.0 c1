local function readAttrOrVal(p, names)
    for _, n in ipairs(names) do
        local ok, v = pcall(function() return p:GetAttribute(n) end)
        if ok and v ~= nil then
            if type(v) == "number" then return v, "attr" end
            if type(v) == "boolean" then return v and 1 or 0, "attr_bool" end
        end
    end
    for _, n in ipairs(names) do
        local v = p:FindFirstChild(n, true)
        if v then
            if v:IsA("NumberValue") or v:IsA("IntValue") then return v.Value, "value"
            elseif v:IsA("BoolValue") then return v.Value and 1 or 0, "value_bool"
            elseif v:IsA("StringValue") then
                local num = tonumber(v.Value)
                if num then return num, "value_str" end
                local a, b = v.Value:match("(%d+)%s*/%s*(%d+)")
                if a then return tonumber(a), "value_str_pair", tonumber(b) end
            end
        end
    end
end
local function findAmmo(tool)
    if not tool then return nil end
    local v, s, e = readAttrOrVal(tool, AMMO_NAMES)
    if v ~= nil then return v, s, e end
    local h = tool:FindFirstChild("Handle")
    if h then
        local v2, s2 = readAttrOrVal(h, AMMO_NAMES)
        if v2 ~= nil then return v2, s2 end
    end
    for _, v in ipairs(tool:GetDescendants()) do
        local ln = v.Name:lower()
        if ln:find("ammo") or ln:find("bullet") or ln:find("round")
            or ln:find("mag") or ln:find("clip") then
            if v:IsA("NumberValue") or v:IsA("IntValue") then return v.Value, "fuzzy_value"
            elseif v:IsA("StringValue") then
                local n = tonumber(v.Value)
                if n then return n, "fuzzy_str" end
                local a, b = v.Value:match("(%d+)%s*/%s*(%d+)")
                if a then return tonumber(a), "fuzzy_str_pair", tonumber(b) end
            end
        end
        for _, n in ipairs(AMMO_NAMES) do
            local ok, av = pcall(function() return v:GetAttribute(n) end)
            if ok and type(av) == "number" then return av, "fuzzy_attr" end
        end
    end
    for _, av in pairs(tool:GetAttributes()) do
        if type(av) == "string" and av:sub(1,1) == "{" then
            local ok, d = pcall(function() return HttpService:JSONDecode(av) end)
            if ok and type(d) == "table" then
                local a = d.ammo or d.current or d.bullets or d.clip or d.rounds or d.loaded
                if type(a) == "number" then return a, "json_attr", d.max or d.maxAmmo end
            end
        end
    end
end
local function findChamber(tool)
    if not tool then return nil end
    local v = readAttrOrVal(tool, CHAMBER_NAMES)
    if v ~= nil then return v end
    local h = tool:FindFirstChild("Handle")
    if h then
        local v2 = readAttrOrVal(h, CHAMBER_NAMES)
        if v2 ~= nil then return v2 end
    end
    for _, v in ipairs(tool:GetDescendants()) do
        local ln = v.Name:lower()
        if ln:find("chamber") or ln:find("ready") or ln:find("reload") or ln:find("bolt") then
            if v:IsA("BoolValue") then return v.Value and 1 or 0 end
            if v:IsA("NumberValue") or v:IsA("IntValue") then return v.Value end
        end
    end
end

local ammoClock = 0
local function updateAmmoHUD(dt)
    ammoClock = ammoClock + (dt or 0)
    if ammoClock < 0.25 then return end
    ammoClock = 0
    if not CFG.AmmoHUD then
        if AmmoFrame.Visible then AmmoFrame.Visible = false end
        return
    end
    local char = LocalPlayer.Character
    if not char then
        if AmmoFrame.Visible then AmmoFrame.Visible = false end
        return
    end
    local tool = getEquippedTool(char)
    if not tool then
        if AmmoFrame.Visible then AmmoFrame.Visible = false end
        return
    end
    if not CFG.AmmoHUDAlways then
        local role = weaponToRole(tool.Name)
        if role ~= "KILLER" and role ~= "VIGILANTE" then
            if AmmoFrame.Visible then AmmoFrame.Visible = false end
            return
        end
    end
    if not AmmoFrame.Visible then AmmoFrame.Visible = true end
    if WLabel.Text ~= tool.Name then WLabel.Text = tool.Name end

    local av, src, extra = findAmmo(tool)
    local cv = findChamber(tool)

    local at
    if av ~= nil then
        local mx = extra and (" / " .. tostring(extra)) or ""
        at = "Ammo: " .. tostring(av) .. mx .. "  [" .. tostring(src) .. "]"
    else
        at = "Ammo not found"
    end
    if ALabel.Text ~= at then ALabel.Text = at end

    local ready, reason = false, ""
    if cv ~= nil then ready = cv > 0; reason = "chamber"
    elseif av ~= nil then ready = av > 0; reason = "ammo>0" end

    if ready then
        local t = "READY" .. (reason ~= "" and (" (" .. reason .. ")") or "")
        if RLabel.Text ~= t then
            RLabel.Text = t
            RLabel.TextColor3 = Color3.fromRGB(80,255,90)
        end
    else
        local t = "NOT READY"
        if RLabel.Text ~= t then
            RLabel.Text = t
            RLabel.TextColor3 = Color3.fromRGB(255,80,80)
        end
    end
end

local function debugDumpTool()
    local c = LocalPlayer.Character
    if not c then print("[BD] No character") return end
    local t = getEquippedTool(c)
    if not t then print("[BD] No tool equipped") return end
    print("[BD] === TOOL DUMP: " .. t.Name .. " ===")
    for k, v in pairs(t:GetAttributes()) do
        print("   ATTR " .. k .. " = " .. tostring(v))
    end
    for _, v in ipairs(t:GetDescendants()) do
        if v:IsA("NumberValue") or v:IsA("IntValue")
            or v:IsA("BoolValue") or v:IsA("StringValue") then
            print("   " .. v.ClassName .. " " .. v:GetFullName() .. " = " .. tostring(v.Value))
        end
        for k, av in pairs(v:GetAttributes()) do
            print("   ATTR@" .. v:GetFullName() .. "." .. k .. " = " .. tostring(av))
        end
    end
    print("[BD] === END ===")
end

