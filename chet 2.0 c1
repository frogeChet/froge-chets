}
local function getEquippedTool(char)
    if not char then return nil end
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Tool") then return v end
    end
    return nil
end
local function isTaskTool(t) return t and NON_WEAPON_TOOLS[normalize(t.Name):gsub("%s+","")] == true end

-- cached tool ONLY for LocalPlayer
local cachedToolLocal = nil
local cachedToolClock = 0
local function getEquippedToolLocalCached()
    local char = LocalPlayer.Character
    if not char then return nil end
    local now = os.clock()
    if now - cachedToolClock >= 0.25 then
        cachedToolClock = now
        cachedToolLocal = nil
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Tool") then cachedToolLocal = v; break end
        end
    end
    return cachedToolLocal
end

local function updateRole(plr)
    local char = plr.Character
    local tool = (plr == LocalPlayer) and getEquippedToolLocalCached() or getEquippedTool(char)
    if tool and not isTaskTool(tool) then
        local role = weaponToRole(tool.Name)
        if role then
            if CFG.RoleRemember and RoleCache[plr] then return RoleCache[plr] end
            RoleCache[plr] = role
            return role
        end
    end
    if CFG.RoleRemember then return RoleCache[plr] end
    return nil
end
