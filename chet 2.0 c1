--// Config persistence (safe for Xeno)
local ConfigFile = "BD_Config.json"
local function saveConfig()
    if not writefile then return end
    local ok, data = pcall(function()
        local t = {}
        for k, v in pairs(CFG) do
            if typeof(v) == "EnumItem" then
                t[k] = { __enum = v.EnumType.Name, value = v.Name }
            elseif typeof(v) == "number" or typeof(v) == "boolean" or typeof(v) == "string" then
                t[k] = v
            end
        end
        return HttpService:JSONEncode(t)
    end)
    if ok and data then pcall(writefile, ConfigFile, data) end
end
local function loadConfig()
    if not isfile then return end
    local okExists, exists = pcall(isfile, ConfigFile)
    if not okExists or not exists then return end
    if not readfile then return end
    local okRaw, raw = pcall(readfile, ConfigFile)
    if not okRaw or not raw then return end
    local okData, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if not okData or type(data) ~= "table" then return end
    for k, v in pairs(data) do
        if type(v) == "table" and v.__enum then
            local et = Enum[v.__enum]
            if et then
                local item = et[v.value]
                if item then CFG[k] = item end
            end
        elseif CFG[k] ~= nil then
            CFG[k] = v
        end
    end
end
loadConfig()

