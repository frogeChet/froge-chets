}
local function normalize(n)
    n = tostring(n or "")
    return (n:gsub("^%s+",""):gsub("%s+$","")):lower()
end
local WEAPON_ROLE = {}
local function register(list, role)
    for _, w in ipairs(list) do
        WEAPON_ROLE[normalize(w)] = role
        for _, p in ipairs(SKIN_PREFIXES) do
            if w:sub(1,#p) == p then WEAPON_ROLE[normalize(w:sub(#p+1))] = role end
        end
    end
end
register(KILLER_WEAPONS, "KILLER")
register(VIGILANTE_WEAPONS, "VIGILANTE")

local function baseName(n)
    for _, p in ipairs(SKIN_PREFIXES) do
        local lp = normalize(p)
        if n:sub(1,#lp) == lp then return n:sub(#lp+1) end
    end
    return n
end
local function weaponToRole(name)
    if not name then return nil end
    local n = normalize(name)
    local b = baseName(n)
    if WEAPON_ROLE[n] then return WEAPON_ROLE[n] end
    if WEAPON_ROLE[b] then return WEAPON_ROLE[b] end
    if not CFG.RoleFuzzy then return nil end
    local best, bestLen = nil, 0
    for k, r in pairs(WEAPON_ROLE) do
        if #k > 4 and #k > bestLen and (n:find(k,1,true) or k:find(n,1,true)) then
            best, bestLen = r, #k
        end
    end
    return best
end

