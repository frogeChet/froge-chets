--// ============================================================
--// AIM (simplified — no camPosLock, no fighting recoil)
--// ============================================================
local aimHeld, aimToggled = false, false
local currentTarget = nil
local lastFire = 0

local function markFire() lastFire = os.clock() end
local function isFiring() return (os.clock() - lastFire) < (CFG.AimFireGrace or 0.22) end

local function aimActive()
    if not CFG.AimEnabled then return false end
    if CFG.AimOnlyArmed and not getEquippedToolLocalCached() then return false end
    if CFG.AimToggleMode then return aimToggled end
    return aimHeld
end
local function getBonePart(char)
    return char:FindFirstChild(CFG.AimBone)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("HumanoidRootPart")
        or char.PrimaryPart
end
local function findTarget()
    local center = aimCenter()
    local fov = fovPixels()
    local best, bestDelta = nil, fov
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local ok, char = isAlive(plr)
            local skip = (CFG.TeamEnemyOnly and not isEnemy(plr))
                or (CFG.ESPTeamCheck and sameTeamAttr(plr))
            if ok and not skip then
                local bone = getBonePart(char)
                if bone then
                    local sp, on = Camera:WorldToViewportPoint(bone.Position)
                    local d3 = (Camera.CFrame.Position - bone.Position).Magnitude
                    if on and d3 <= CFG.AimMaxDist then
                        local delta = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if delta <= fov and delta < bestDelta then
                            if (not CFG.AimWallCheck) or visibleFrom(bone) then
                                best, bestDelta = plr, delta
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end
local function targetStillValid(plr)
    if not plr or not plr.Parent then return false end
    local ok, char = isAlive(plr); if not ok then return false end
    local bone = getBonePart(char); if not bone then return false end
    local sp, on = Camera:WorldToViewportPoint(bone.Position)
    if not on then return false end
    if (Vector2.new(sp.X, sp.Y) - aimCenter()).Magnitude > fovPixels() * 1.35 then return false end
    if CFG.AimWallCheck and not visibleFrom(bone) then return false end
    return true, bone
end

local rng = Random.new()
local function jitterCFrame(cf)
    if not CFG.AimHumanize or CFG.AimJitter <= 0 then return cf end
    local j = math.rad(CFG.AimJitter)
    return cf * CFrame.Angles(rng:NextNumber(-j, j), rng:NextNumber(-j, j), 0)
end

-- Auto-Fire (simple, no CaptureController)
local lastAutoFire = 0
local autoFireBusy = false
local function tryAutoFire()
    if not CFG.AutoFire then return end
    if autoFireBusy then return end
    if not currentTarget then return end
    if not aimActive() then return end
    if isFiring() then return end
    local now = os.clock()
    if now - lastAutoFire < (CFG.AutoFireCooldown or 0.15) then return end

    local ok, char = isAlive(currentTarget)
    if not ok then return end
    local head = char:FindFirstChild("Head")
    if not head then return end
    if not visibleFrom(head) then return end

    local hs, on = Camera:WorldToViewportPoint(head.Position)
    if not on then return end
    if (Vector2.new(hs.X, hs.Y) - aimCenter()).Magnitude > (CFG.AutoFireRadius or 12) then return end

    if CFG.AutoFireOnlyHead then
        local tb = getBonePart(char)
        if tb and tb.Name ~= "Head" then return end
    end

    lastAutoFire = now
    markFire()
    autoFireBusy = true
    task.spawn(function()
        pcall(function()
            if mouse1click then
                mouse1click()
            elseif VirtualUser then
                VirtualUser:Button1Down(Vector2.new(0.5, 0.5))
                task.wait(0.02)
                VirtualUser:Button1Up(Vector2.new(0.5, 0.5))
            end
        end)
        task.wait(0.05)
        autoFireBusy = false
    end)
end

local aimSearchClock = 0
local function stepAim(dt)
    updateFov(CFG.AimShowFOV and aimActive())
    if not aimActive() then
        currentTarget = nil
        return
    end
    -- While firing: don't touch camera, let game handle recoil
    if isFiring() then return end

    local bone
    if CFG.AimSticky and currentTarget then
        local v, b = targetStillValid(currentTarget)
        if v then bone = b else currentTarget = nil end
    end
    if not currentTarget then
        aimSearchClock = aimSearchClock + dt
        if aimSearchClock >= 0.1 then
            aimSearchClock = 0
            currentTarget = findTarget()
            if currentTarget then
                local _, b = targetStillValid(currentTarget)
                bone = b
            end
        end
    end
    if not currentTarget or not bone then return end

    local camPos = Camera.CFrame.Position
    local wantDir = (bone.Position - camPos).Unit
    local curDir = Camera.CFrame.LookVector
    local alpha = 1 - math.exp(-math.max(CFG.AimSmooth, 0.001) * 60 * dt)
    local newDir = curDir:Lerp(wantDir, math.clamp(alpha, 0, 1)).Unit
    local newCF = CFrame.lookAt(camPos, camPos + newDir)
    Camera.CFrame = jitterCFrame(newCF)
end

