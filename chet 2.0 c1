--// Anti-Ragdoll (throttled 30Hz)
--// ============================================================
local antiConn = nil
local BANNED = {
    BallSocketConstraint=true, HingeConstraint=true,
    NoCollisionConstraint=true, RopeConstraint=true,
}
local function cleanChar(char)
    if not char or not char.Parent then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    if hum.PlatformStand then hum.PlatformStand = false end
    if hum.Sit then hum.Sit = false end
    if CFG.AntiRagdollForceRun then
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown
            or st == Enum.HumanoidStateType.Physics then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end
    local parts = { char:FindFirstChild("UpperTorso"), char:FindFirstChild("Torso"),
                    char:FindFirstChild("HumanoidRootPart"), char:FindFirstChild("Head") }
    for _, p in ipairs(parts) do
        if p then
            for _, v in ipairs(p:GetChildren()) do
                if BANNED[v.ClassName] then pcall(function() v:Destroy() end)
                elseif v:IsA("Motor6D") and not v.Enabled then v.Enabled = true end
            end
        end
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and CFG.AntiRagdollAnchor and not hrp.Anchored then hrp.Anchored = true end
end
local function startAnti()
    if antiConn then antiConn:Disconnect() end
    local clock = 0
    antiConn = RunService.RenderStepped:Connect(function(dt)
        if not CFG.AntiRagdoll then return end
        clock = clock + dt
        if clock < 1/30 then return end
        clock = 0
        local c = LocalPlayer.Character
        if c then pcall(cleanChar, c) end
    end)
end
local function stopAnti()
    if antiConn then antiConn:Disconnect(); antiConn = nil end
    local c = LocalPlayer.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if hrp and hrp.Anchored then hrp.Anchored = false end
end
if CFG.AntiRagdoll then startAnti() end
LocalPlayer.CharacterAdded:Connect(function() task.wait(0.3) if CFG.AntiRagdoll then startAnti() end end)

