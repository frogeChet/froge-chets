                            o.name.TextColor3 = col
                            o.name.TextSize = 14*k
                            o.name.Size = UDim2.fromOffset(420*k, 18*k)
                            o.name.Position = UDim2.fromOffset(pos.X, y - 11*k)
                            o.name.Visible = true
                        else o.name.Visible = false end
                        if #infoText > 0 then
                            if o.info.Text ~= infoText then o.info.Text = infoText end
                            o.info.TextColor3 = col
