local function findToolTemplate(name)
    local roots = { ReplicatedStorage, Workspace, LocalPlayer:FindFirstChild("Backpack") }
    local lname = name:lower()
    for _, root in ipairs(roots) do
        if root then
            local ok, f = pcall(function() return root:FindFirstChild(name, true) end)
            if ok and f and f:IsA("Tool") then return f end
            for _, v in ipairs(root:GetDescendants()) do
                if v:IsA("Tool") and v.Name:lower() == lname then return v end
            end
        end
    end
end
local function giveWeapon(name)
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not bp then warn("[BD] Backpack not found") return false end
    if bp:FindFirstChild(name) or (char and char:FindFirstChild(name)) then
        print("[BD] Already have: " .. name)
        return false
    end
    local t = findToolTemplate(name)
    if not t then print("[BD] Template not found: " .. name) return false end
    local c = t:Clone()
    c.Parent = bp
    print("[BD] Given: " .. name)
    return true
end

