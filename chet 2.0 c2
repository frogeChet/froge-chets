    bar.BorderSizePixel = 0; bar.Parent = row
    local barC = Instance.new("UICorner", bar)
    barC.CornerRadius = UDim.new(0, 4)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((init-min)/(max-min), 0, 1, 0)
    fill.BackgroundColor3 = THEME.accent
    fill.BorderSizePixel = 0; fill.Parent = bar
    local fc = Instance.new("UICorner", fill)
    fc.CornerRadius = UDim.new(0, 4)
    local dragging = false
    local function apply(v)
        v = math.clamp(v, min, max)
        v = math.floor(v/step + 0.5) * step
        v = math.floor(v*100 + 0.5)/100
        fill.Size = UDim2.new((v-min)/(max-min), 0, 1, 0)
        val.Text = tostring(v)
        if cb then pcall(cb, v) end
    end
    local function fromX(x)
        local abs, w = bar.AbsolutePosition.X, bar.AbsoluteSize.X
        apply(min + (max-min) * math.clamp((x-abs)/w, 0, 1))
    end
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; fromX(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            fromX(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    val.FocusLost:Connect(function()
        local n = tonumber(val.Text)
        if n then apply(n) else val.Text = tostring(init) end
    end)
    return row
end

