
local function findSheriff()
    local function validate(inst)
        if not (inst:IsA("Tool") or inst:IsA("Model")) then return nil end
        if insideChar(inst) or isLocalOrVM(inst) then return nil end
        local part = getWorldAnchor(inst)
        if not part or not part.Parent then return nil end
        return part
    end
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if (inst:IsA("Tool") or inst:IsA("Model")) and isSheriff(inst) then
            local p = validate(inst)
            if p then return inst, p end
        end
    end
    if CFG.SheriffTPAnyDrop then
        for _, inst in ipairs(Workspace:GetDescendants()) do
            if inst:IsA("Tool") then
                local p = validate(inst)
                if p then return inst, p end
            end
        end
        for _, inst in ipairs(Workspace:GetDescendants()) do
            if inst:IsA("Model") and weaponToRole(inst.Name) then
                local p = validate(inst)
                if p then return inst, p end
            end
        end
    end
end
local function teleportSheriff(silent)
    local gun, part = findSheriff()
    if not gun or not part then
        if not silent then print("[BD] " .. L("tp_msg_notfound")) end
        return false
    end
    local c = LocalPlayer.Character
    if not c or not c.PrimaryPart then
        if not silent then print("[BD] Character not ready") end
        return false
    end
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then
        if not silent then print("[BD] You are dead") end
        return false
    end
    c:PivotTo(CFrame.new(part.Position + Vector3.new(0, 3, 0)))
    print("[BD] " .. L("tp_msg_found") .. ": " .. gun.Name)
    return true
end
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if not CFG.SheriffTPEnabled then return end
    if input.KeyCode == CFG.SheriffTPKey then teleportSheriff(false) end
end)

