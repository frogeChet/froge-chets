--// ============================================================
--// Main loop (single, throttled)
--// ============================================================
local espClock = 0
local dropClock = 0
RunService.RenderStepped:Connect(function(dt)
    local ok, err = pcall(function()
        espClock = espClock + dt
        if espClock >= 1/45 then
            espClock = 0
            renderESP()
            renderDrops()
            stepAim(dt * 2)
            updateAmmoHUD(dt * 2)
        else
            stepAim(dt)
        end
        tryAutoFire()
        dropClock = dropClock + dt
        if dropClock >= (CFG.DropScanRate or 1.5) then
            dropClock = 0
            scanDrops()
        end
    end)
    if not ok then warn("[BD] render err: " .. tostring(err)) end
end)

