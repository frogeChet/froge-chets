local function hideModelESP(plr)
	local m = ModelESP[plr]; if not m then return end
	m.hl.Enabled = false
	m.bb.Enabled = false
end
local function removeModelESP(plr)
	local m = ModelESP[plr]; if not m then return end
	pcall(function() m.hl:Destroy() end)
	pcall(function() m.bb:Destroy() end)
	ModelESP[plr] = nil
end
local function updateModelESP(plr, char, col, titleText, subText, hpPct)
	local m = ModelESP[plr] or createModelESP(plr)
	local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
	if not head then hideModelESP(plr); return end
	local k = S()
	m.hl.Adornee = char
	m.hl.FillColor = col
	m.hl.OutlineColor = col
	m.hl.FillTransparency = CFG.ESPBox and 0.72 or 1
	m.hl.Enabled = true
	m.bb.Adornee = head
	m.bb.Size = UDim2.fromOffset(240 * k, 56 * k)
	m.bb.Enabled = true
	m.title.Size = UDim2.new(1, 0, 0, 20 * k)
	m.title.TextSize = 14 * k
	m.title.Text = CFG.ESPName and (titleText or "") or ""
	m.title.TextColor3 = col
	m.sub.Position = UDim2.new(0, 0, 0, 20 * k)
	m.sub.Size = UDim2.new(1, 0, 0, 18 * k)
	m.sub.TextSize = 12 * k
	m.sub.Text = subText or ""
	m.sub.TextColor3 = col
	m.barBg.Position = UDim2.new(0.5, 0, 0, 40 * k)
	m.barBg.Size = UDim2.new(0, 90 * k, 0, 4 * k)
	m.barBg.Visible = CFG.ESPHealth and hpPct ~= nil
	if hpPct then
		m.barFill.Size = UDim2.new(hpPct, 0, 1, 0)
		m.barFill.BackgroundColor3 = COLOR.healthLow:Lerp(COLOR.healthOk, hpPct)
	end
end

