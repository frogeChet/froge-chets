local function newFrame(parent, zindex)
	local f = Instance.new("Frame")
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.ZIndex = zindex or 2
	f.Visible = false
	f.Parent = parent
	return f
end
local function newStroke(parent, color, thickness)
	local st = Instance.new("UIStroke")
	st.Color = color
	st.Thickness = thickness or 1
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Parent = parent
	return st
end
local function newLabel(parent, bold, zindex)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
	t.TextStrokeTransparency = 0.35
	t.TextXAlignment = Enum.TextXAlignment.Center
	t.TextYAlignment = Enum.TextYAlignment.Center
	t.AnchorPoint = Vector2.new(0.5, 0.5)
	t.ZIndex = zindex or 3
	t.Visible = false
	t.Parent = parent
	return t
end
local function setLine(frame, from, to, thickness, color)
	local d = to - from
	local len = d.Magnitude
	frame.AnchorPoint = Vector2.new(0, 0.5)
	frame.Position = UDim2.fromOffset(from.X, from.Y)
	frame.Size = UDim2.fromOffset(len, math.max(1, thickness))
	frame.Rotation = math.deg(math.atan2(d.Y, d.X))
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = 0
	frame.Visible = true
end

