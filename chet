local ESPObjects = {}
local function createESP(plr)
	local box    = newFrame(Screen, 2)
	local boxOut = newStroke(box, Color3.new(0, 0, 0), 3)
	local boxIn  = newStroke(box, COLOR.default, 1)
	boxIn.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ESPObjects[plr] = {
		box = box, boxOut = boxOut, boxIn = boxIn,
		name = newLabel(Screen, true, 4),
		info = newLabel(Screen, false, 4),
		healthBg = newFrame(Screen, 2),
		health   = newFrame(Screen, 3),
		tracer   = newFrame(Screen, 1),
	}
end
local function hideDrawings(o)
	if not o then return end
	for key, d in pairs(o) do
		if key ~= "boxOut" and key ~= "boxIn" then d.Visible = false end
	end
end
local function hideESP(plr) hideDrawings(ESPObjects[plr]); hideModelESP(plr) end
local function removeESP(plr)
	removeModelESP(plr)
	local o = ESPObjects[plr]; if not o then return end
	for key, d in pairs(o) do
		if key ~= "boxOut" and key ~= "boxIn" then pcall(function() d:Destroy() end) end
	end
	ESPObjects[plr] = nil
end
for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then createESP(p) end end
