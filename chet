local function normalize(name)
	name = tostring(name or "")
	name = name:gsub("^%s+", ""):gsub("%s+$", "")
	return name:lower()
end
local WEAPON_ROLE = {}
local function register(list, role)
	for _, w in ipairs(list) do
		WEAPON_ROLE[normalize(w)] = role
		for _, p in ipairs(SKIN_PREFIXES) do
			if w:sub(1, #p) == p then
				WEAPON_ROLE[normalize(w:sub(#p + 1))] = role
			end
		end
	end
end
register(KILLER_WEAPONS, "KILLER")
register(VIGILANTE_WEAPONS, "VIGILANTE")

local function baseName(n)
	for _, p in ipairs(SKIN_PREFIXES) do
		local lp = normalize(p)
		if n:sub(1, #lp) == lp then return n:sub(#lp + 1) end
	end
	return n
end
local function weaponToRole(toolName)
	if not toolName then return nil end
	local n = normalize(toolName)
	local b = baseName(n)
	if WEAPON_ROLE[n] then return WEAPON_ROLE[n] end
	if WEAPON_ROLE[b] then return WEAPON_ROLE[b] end
	if not CFG.RoleFuzzy then return nil end
	local best, bestLen = nil, 0
	for key, role in pairs(WEAPON_ROLE) do
		if #key > 4 and #key > bestLen and (n:find(key, 1, true) or key:find(n, 1, true)) then
			best, bestLen = role, #key
		end
	end
	return best
end

local RoleCache = {}
local function clearRoles() RoleCache = {} end

local NON_WEAPON_TOOLS = {
	["mop"] = true, ["kitchenknife"] = true, ["gardeningscissors"] = true,
	["toolbelt"] = true, ["ducttape"] = true,
}
local function getEquippedTool(char)
	if not char then return nil end
	for _, v in ipairs(char:GetChildren()) do
		if v:IsA("Tool") then return v end
	end
	return nil
end
local function isTaskTool(tool)
	return tool and NON_WEAPON_TOOLS[normalize(tool.Name):gsub("%s+", "")] == true
end
local function updateRole(plr)
	local char = plr.Character
	local tool = getEquippedTool(char)
	if tool and not isTaskTool(tool) then
		local role = weaponToRole(tool.Name)
		if role then
			if CFG.RoleRemember and RoleCache[plr] then return RoleCache[plr] end
			RoleCache[plr] = role
			return role
		end
	end
	if CFG.RoleRemember then return RoleCache[plr] end
	return nil
end
LocalPlayer.CharacterAdded:Connect(clearRoles)

