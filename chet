--// ---- Team utils ----
local function getTeamAttr(plr)
	local ch = plr and plr.Character
	if not ch then return nil end
	local t = ch:GetAttribute("Team")
	if type(t) == "string" and t ~= "" then return t end
	return nil
end
local function myTeam() return getTeamAttr(LocalPlayer) end
local function sameTeamAttr(plr)
	local a, b = getTeamAttr(plr), myTeam()
	return a ~= nil and b ~= nil and a == b
end
local function isEnemy(plr)
	local a, b = getTeamAttr(plr), myTeam()
	if not a or not b then return true end
	return a ~= b
end

local TEAM_TAGS = {
	Attackers = { text = "ATTACKERS", color = COLOR.attackers },
	Defenders = { text = "DEFENDERS", color = COLOR.defenders },
	Detective = { text = "DETECTIVE", color = COLOR.detective },
}

local function getHum(char) return char and char:FindFirstChildOfClass("Humanoid") end
local function isAlive(plr)
	local ch = plr.Character
	local hum = getHum(ch)
	local root = ch and (ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart)
	return ch and hum and root and hum.Health > 0, ch, hum, root
end

local function visibleFrom(originPart)
	if not originPart then return false end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { LocalPlayer.Character, Camera }
	params.IgnoreWater = true
	local from = Camera.CFrame.Position
	local dir  = originPart.Position - from
	local hit  = Workspace:Raycast(from, dir, params)
	if not hit then return true end
	return hit.Instance:IsDescendantOf(originPart.Parent)
end

--// ---- Drops ----
local DropObjects = {}
local dropClock = 0
local function dropAnchor(inst)
	if inst:IsA("BasePart") then return inst end
	if inst:IsA("Tool") or inst:IsA("Model") then
		return (inst:IsA("Model") and inst.PrimaryPart)
			or inst:FindFirstChild("Handle")
			or inst:FindFirstChildWhichIsA("BasePart")
	end
	return nil
end
local function insideCharacter(inst)
	local node = inst
	while node and node ~= Workspace do
		if node:FindFirstChildOfClass("Humanoid") then return true end
		node = node.Parent
	end
	return false
end
local function isLocalOrViewmodel(inst)
	if Camera and inst:IsDescendantOf(Camera) then return true end
	local ch = LocalPlayer.Character
	if ch and inst:IsDescendantOf(ch) then return true end
	local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
	if bp and inst:IsDescendantOf(bp) then return true end
	for _, plr in ipairs(Players:GetPlayers()) do
		local other = plr.Character
		if other and inst:IsDescendantOf(other) then return true end
	end
	return false
end
local function createDropESP(inst, part, role)
	local hl = Instance.new("Highlight")
	hl.Name = "BD_DROP_HL"
	hl.FillTransparency = 0.6
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Enabled = false
	hl.Parent = Screen
	local bb = Instance.new("BillboardGui")
	bb.Name = "BD_DROP_BB"
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Size = UDim2.fromOffset(220, 34)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 1.2, 0)
	bb.Enabled = false
	bb.Parent = Screen
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, 16)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 13
	label.TextStrokeTransparency = 0.35
	label.Parent = bb
	local sub = label:Clone()
	sub.Font = Enum.Font.Gotham
	sub.TextSize = 11
	sub.Position = UDim2.new(0, 0, 0, 16)
	sub.Parent = bb
	DropObjects[inst] = { hl = hl, bb = bb, label = label, sub = sub, part = part, role = role }
	return DropObjects[inst]
end
local function removeDropESP(inst)
	local d = DropObjects[inst]; if not d then return end
	pcall(function() d.hl:Destroy() end)
	pcall(function() d.bb:Destroy() end)
	DropObjects[inst] = nil
end
local function scanDrops()
	if not CFG.DropESP then
		for inst in pairs(DropObjects) do removeDropESP(inst) end
		return
	end
	local found = {}
	for _, inst in ipairs(Workspace:GetDescendants()) do
		if inst:IsA("Tool") or inst:IsA("Model") then
			local role = weaponToRole(inst.Name)
			if role and not insideCharacter(inst) and not isLocalOrViewmodel(inst) then
				local part = dropAnchor(inst)
				if part then found[inst] = { part = part, role = role } end
			end
		end
	end
	for inst in pairs(DropObjects) do
		if not found[inst] or not inst.Parent then removeDropESP(inst) end
	end
	for inst, data in pairs(found) do
		local d = DropObjects[inst] or createDropESP(inst, data.part, data.role)
		d.part = data.part
		d.role = data.role
	end
end
local function renderDrops()
	for inst, d in pairs(DropObjects) do
		if not inst.Parent or not d.part or not d.part.Parent then
			removeDropESP(inst)
		else
			local dist = (Camera.CFrame.Position - d.part.Position).Magnitude
			if not CFG.DropESP or dist > CFG.DropMaxDist or dist < (CFG.DropMinDist or 8) then
				d.bb.Enabled = false
				d.hl.Enabled = false
			else
				local col = (d.role == "KILLER") and COLOR.killer or COLOR.vigilante
				local k = S()
				d.bb.Adornee = d.part
				d.bb.Size = UDim2.fromOffset(220 * k, 34 * k)
				d.bb.Enabled = true
				d.label.Size = UDim2.new(1, 0, 0, 16 * k)
				d.label.TextSize = 13 * k
				d.label.Text = inst.Name .. "  [" .. d.role .. " GUN]"
				d.label.TextColor3 = col
				d.sub.Position = UDim2.new(0, 0, 0, 16 * k)
				d.sub.Size = UDim2.new(1, 0, 0, 14 * k)
				d.sub.TextSize = 11 * k
				d.sub.Text = math.floor(dist) .. "m  |  dropped"
				d.sub.TextColor3 = col
				d.hl.Adornee = inst:IsA("Model") and inst or d.part
				d.hl.OutlineColor = col
				d.hl.FillColor = col
				d.hl.Enabled = CFG.DropHighlight
			end
		end
	end
end

--// ---- ESP render ----
local function renderESP()
	local modelMode = (CFG.ESPMode == "Model")
	local vp = Camera.ViewportSize
	local k  = S()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local o = ESPObjects[plr]
			local ok, char, hum, root = isAlive(plr)
			local skip = (not CFG.ESP) or (not ok) or (CFG.ESPTeamCheck and sameTeamAttr(plr))
			if skip then
				hideESP(plr)
			else
				local head = char:FindFirstChild("Head") or root
				local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
				local dist = (Camera.CFrame.Position - root.Position).Magnitude
				if dist > CFG.ESPMaxDist or (not modelMode and not onScreen) then
					hideESP(plr)
				else
					local tag, col = nil, COLOR.default
					local teamAttr = CFG.TeamESP and getTeamAttr(plr) or nil
					if teamAttr then
						local info = TEAM_TAGS[teamAttr]
						tag = info and info.text or teamAttr:upper()
						if CFG.TeamColors then
							if myTeam() then
								col = sameTeamAttr(plr) and COLOR.ally or COLOR.enemy
							else
								col = info and info.color or COLOR.default
							end
						end
					end
					local role = (CFG.RoleESP and not teamAttr) and updateRole(plr) or nil
					if role then
						tag = tag and (tag .. " / " .. role) or role
						if role == "KILLER" then col = COLOR.killer
						elseif role == "VIGILANTE" then col = COLOR.vigilante end
					end
					local label = plr.DisplayName ~= plr.Name
						and (plr.DisplayName .. " (@" .. plr.Name .. ")") or plr.Name
					if tag then label = label .. "  [" .. tag .. "]" end
					local parts = {}
					if CFG.ESPDistance then table.insert(parts, math.floor(dist) .. "m") end
					if CFG.ESPHealth then table.insert(parts, math.floor(hum.Health) .. "hp") end
					local tool = getEquippedTool(char)
					if tool then table.insert(parts, tool.Name) end
					local infoText = table.concat(parts, " | ")
					local hpPct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)

					if modelMode then
						hideDrawings(o)
						updateModelESP(plr, char, col, label, infoText, hpPct)
						if o and CFG.ESPTracer and onScreen then
							setLine(o.tracer, Vector2.new(vp.X / 2, vp.Y), Vector2.new(pos.X, pos.Y), 1.5 * k, col)
						end
					elseif o then
						hideModelESP(plr)
						local topV    = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6, 0))
						local bottomV = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3.2, 0))
						local h = math.abs(bottomV.Y - topV.Y)
						local w = h * 0.52
						local x = pos.X - w / 2
						local y = topV.Y
						if CFG.ESPBox then
							o.box.Position = UDim2.fromOffset(x, y)
							o.box.Size = UDim2.fromOffset(w, h)
							o.boxOut.Thickness = math.max(1, 2.5 * k)
							o.boxIn.Thickness = math.max(1, 1.2 * k)
							o.boxIn.Color = col
							o.box.Visible = true
						else o.box.Visible = false end
						if CFG.ESPName then
							o.name.Text = label
							o.name.TextColor3 = col
							o.name.TextSize = 14 * k
							o.name.Size = UDim2.fromOffset(420 * k, 18 * k)
							o.name.Position = UDim2.fromOffset(pos.X, y - 11 * k)
							o.name.Visible = true
						else o.name.Visible = false end
						if #infoText > 0 then
							o.info.Text = infoText
							o.info.TextColor3 = col
							o.info.TextSize = 12 * k
							o.info.Size = UDim2.fromOffset(420 * k, 16 * k)
							o.info.Position = UDim2.fromOffset(pos.X, y + h + 10 * k)
							o.info.Visible = true
						else o.info.Visible = false end
						if CFG.ESPHealth then
							local barW = math.max(2, 3 * k)
							local bx = x - barW - 3 * k
							o.healthBg.Position = UDim2.fromOffset(bx, y)
							o.healthBg.Size = UDim2.fromOffset(barW, h)
							o.healthBg.BackgroundColor3 = Color3.new(0, 0, 0)
							o.healthBg.BackgroundTransparency = 0
							o.healthBg.Visible = true
							o.health.AnchorPoint = Vector2.new(0, 1)
							o.health.Position = UDim2.fromOffset(bx, y + h)
							o.health.Size = UDim2.fromOffset(barW, h * hpPct)
							o.health.BackgroundColor3 = COLOR.healthLow:Lerp(COLOR.healthOk, hpPct)
							o.health.BackgroundTransparency = 0
							o.health.Visible = true
						else
							o.healthBg.Visible = false
							o.health.Visible = false
						end
						if CFG.ESPTracer then
							setLine(o.tracer, Vector2.new(vp.X / 2, vp.Y), Vector2.new(pos.X, y + h), 1.5 * k, col)
						else o.tracer.Visible = false end
					end
				end
			end
		end
	end
end

