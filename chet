--// ---- AIM (fixed drift) ----
local aimHeld, aimToggled = false, false
local currentTarget = nil
local lastFire = 0
local camPosLock = nil

local function markFire() lastFire = os.clock() end
local function isFiring() return (os.clock() - lastFire) < (CFG.AimFireGrace or 0.18) end

local function aimActive()
	if not CFG.AimEnabled then return false end
	if CFG.AimOnlyArmed and not getEquippedTool(LocalPlayer.Character) then return false end
	if CFG.AimToggleMode then return aimToggled end
	return aimHeld
end
local function getBonePart(char)
	return char:FindFirstChild(CFG.AimBone)
		or char:FindFirstChild("Head")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("HumanoidRootPart")
		or char.PrimaryPart
end
local function findTarget()
	local center = aimCenter()
	local fov = fovPixels()
	local best, bestDelta = nil, fov
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local ok, char = isAlive(plr)
			local skip = (CFG.TeamEnemyOnly and not isEnemy(plr))
				or (CFG.ESPTeamCheck and sameTeamAttr(plr))
			if ok and not skip then
				local bone = getBonePart(char)
				if bone then
					local sp, on = Camera:WorldToViewportPoint(bone.Position)
					local dist3d = (Camera.CFrame.Position - bone.Position).Magnitude
					if on and dist3d <= CFG.AimMaxDist then
						local delta = (Vector2.new(sp.X, sp.Y) - Vector2.new(center.X, center.Y)).Magnitude
						if delta <= fov and delta < bestDelta then
							if (not CFG.AimWallCheck) or visibleFrom(bone) then
								best, bestDelta = plr, delta
							end
						end
					end
				end
			end
		end
	end
	return best
end
local function targetStillValid(plr)
	if not plr or not plr.Parent then return false end
	local ok, char = isAlive(plr); if not ok then return false end
	local bone = getBonePart(char); if not bone then return false end
	local sp, on = Camera:WorldToViewportPoint(bone.Position)
	if not on then return false end
	local center = aimCenter()
	local delta = (Vector2.new(sp.X, sp.Y) - Vector2.new(center.X, center.Y)).Magnitude
	if delta > fovPixels() * 1.35 then return false end
	if CFG.AimWallCheck and not visibleFrom(bone) then return false end
	return true, bone
end

local rng = Random.new()
local function jitterCFrame(cf)
	if not CFG.AimHumanize or CFG.AimJitter <= 0 then return cf end
	if isFiring() then return cf end
	local j = math.rad(CFG.AimJitter)
	return cf * CFrame.Angles(rng:NextNumber(-j, j), rng:NextNumber(-j, j), 0)
end

local function stepAim(dt)
	updateFovCircle(CFG.AimShowFOV and aimActive())
	if not aimActive() then currentTarget = nil; camPosLock = nil; return end
	if isFiring() then camPosLock = Camera.CFrame.Position; return end

	local bone
	if CFG.AimSticky and currentTarget then
		local valid, b = targetStillValid(currentTarget)
		if valid then bone = b else currentTarget = nil end
	end
	if not currentTarget then
		currentTarget = findTarget()
		if currentTarget then
			local _, b = targetStillValid(currentTarget)
			bone = b
		end
	end
	if not currentTarget or not bone then camPosLock = nil; return end

	local camPos = camPosLock or Camera.CFrame.Position
	local wantDir = (bone.Position - camPos).Unit
	local curDir  = Camera.CFrame.LookVector
	local alpha = 1 - math.exp(-math.max(CFG.AimSmooth, 0.001) * 60 * dt)
	local newDir = curDir:Lerp(wantDir, math.clamp(alpha, 0, 1)).Unit
	local newCF = CFrame.lookAt(camPos, camPos + newDir)
	newCF = jitterCFrame(newCF)
	Camera.CFrame = CFrame.new(camPos) * (newCF - newCF.Position)
end

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then markFire() end
	local match = (input.UserInputType == CFG.AimKey) or (input.KeyCode == CFG.AimKey)
	if match then
		aimHeld = true
		if CFG.AimToggleMode then aimToggled = not aimToggled end
	end
end)
UserInputService.InputEnded:Connect(function(input)
	local match = (input.UserInputType == CFG.AimKey) or (input.KeyCode == CFG.AimKey)
	if match then aimHeld = false end
end)

RunService.RenderStepped:Connect(function(dt)
	local ok, err = pcall(function()
		renderESP()
		renderDrops()
		dropClock = dropClock + dt
		if dropClock >= (CFG.DropScanRate or 1.5) then
			dropClock = 0
			scanDrops()
		end
		stepAim(dt)
	end)
	if not ok then warn("[BD] " .. tostring(err)) end
end)

